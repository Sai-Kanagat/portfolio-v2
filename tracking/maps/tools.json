      "change": [
       "ab_upload[item=A:png]",
       "re:^ab_result\\[item=(A|B|tie),bucket=(lt4|4-10|10-20|20\\+)\\]$"
      ]
     }
    },
    "ad.ab.file_b": {
     "kind": "file",
     "emits": {
      "change": [
       "ab_upload[item=B:png]",
       "re:^ab_result\\[item=(A|B|tie),bucket=(lt4|4-10|10-20|20\\+)\\]$"
