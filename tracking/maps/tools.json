      "click": [
       "track:demo_end[reason=%R]"
      ]
     },
     "note": "Navigation link: the generic ui_click or nav_click comes from track.js, the page adds demo_end."
    },
    "agora.seed": {
     "kind": "textarea",
     "emits": {
      "type": [
       "seed_edit[bucket=21-80]"
      ]
     },
     "note": "Debounced 700 ms, length bucket only."
    },
    "agora.preset.pricing": {
     "kind": "button",
     "emits": {
      "click": [
       "preset[item=pricing]"
      ]
     }
    },
    "agora.preset.policy": {
     "kind": "button",
     "emits": {
      "click": [
       "preset[item=policy]"
      ]
     }
    },
    "agora.preset.brand": {
     "kind": "button",
     "emits": {
      "click": [
       "preset[item=brand]"
      ]
     }
    },
    "agora.preset.culture": {
     "kind": "button",
     "emits": {
      "click": [
       "preset[item=culture]"
      ]
     }
    },
    "agora.population": {
     "kind": "number",
     "emits": {
      "type": [
       "population[bucket=q4]"
      ]
     },
     "note": "Quintile of 20..120."
    },
    "agora.ticks": {
     "kind": "number",
     "emits": {
      "type": [
       "ticks[bucket=q3]"
      ]
     },
     "note": "Quintile of 60..600."
    },
    "agora.go": {
     "kind": "button",
     "emits": {
      "empty": [
       "go[item=empty]"
      ],
      "custom": [
       "go[item=custom]",
       "step[item=step2]"
      ],
      "preset": [
       "go[item=pricing]"
      ]
     },
     "note": "Source is a preset id or custom, never the seed text. step fires once per step."
    },
    "agora.simulate": {
     "kind": "button",
     "emits": {
      "click": [
       "simulate[item=large]",
       "step[item=step3]"
      ]
     },
     "note": "item is a population class: small, mid, large."
    },
    "agora.back_to_seed": {
     "kind": "button",
     "emits": {
      "click": [
       "back_to_seed"
      ]
     }
    },
    "agora.skip": {
     "kind": "button",
     "emits": {
      "click": [
       "re:^skip_to_end\\[bucket=q[1-5]\\]$",
       "report[item=skip]",
       "re:^result\\[item=[a-z]+,bucket=(strong|lean|fragmented)\\]$",
       "step[item=step4]"
      ]
     },
     "note": "Skip finishes the run, so the report events chain from it."
    },
    "agora.report": {
     "kind": "button",
     "emits": {
      "auto": [
       "report[item=auto]",
       "re:^result\\[item=[a-z]+,bucket=(strong|lean|fragmented)\\]$",
       "step[item=step4]",
       "opt:re:^fps\\[bucket=(lt20|20-40|40-55|55\\+)\\]$"
      ]
     },
     "note": "Disabled until the run ends, then clicked by the page itself, so it is exercised through the auto run."
    },
    "agora.new_scenario": {
     "kind": "button",
     "emits": {
      "click": [
       "new_scenario"
      ]
     }
    }
   },
   "views": {},
   "listeners": [
    {
     "match": "seedInput.\\)\\.value = b\\.dataset",
     "maps": "agora.preset.*"
    },
    {
     "match": "goBtn.\\)\\.onclick",
     "maps": "agora.go"
    },
    {
     "match": "simBtn.\\)\\.onclick",
     "maps": "agora.simulate"
    },
    {
     "match": "backTo1Btn.\\)\\.onclick",
     "maps": "agora.back_to_seed"
    },
    {
     "match": "addEventListener\\(.resize., resize\\)",
     "maps": "ignore: canvas resize, no tracking"
    },
    {
     "match": "skipBtn.\\)\\.onclick",
     "maps": "agora.skip"
    },
    {
     "match": "reportBtn.\\)\\.onclick",
     "maps": "agora.report"
    },
    {
     "match": "restartBtn.\\)\\.onclick",
     "maps": "agora.new_scenario"
    },
    {
     "match": "sd\\.addEventListener\\(.input.",
     "maps": "agora.seed"
    },
    {
     "match": "f\\.addEventListener\\(.input.",
     "maps": "agora.population, agora.ticks"
    }
   ]
  },
