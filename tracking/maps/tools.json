{
 "version": 1,
 "owner": "tools",
 "note": "Generated from tracking/tests/tools/spec.mjs. Event strings: action[item,bucket,value,ms] for demo_action, track:name for catalogue events, model:state for model_state. re: marks a pattern, opt: an optional event. Lifecycle events (demo_open, demo_start, demo_engaged, demo_end, first_interaction, return_visit) come from the shared helper on every page and are not repeated per control.",
 "helper": {
  "listeners": [
   "pointermove/scroll/wheel/touchmove: active-time clock only, no event",
   "pointerdown/keydown/input/change (capture): first_interaction once",
   "visibilitychange, pagehide: demo_end",
   "click on a[data-track] ending .back or .home: demo_end",
   "error, unhandledrejection: demo_error js or promise, three at most",
   "sk:consent: return_visit check"
  ],
  "sites": [
   {
    "type": "visibilitychange",
    "match": "document\\.addEventListener\\('visibilitychange',function\\(\\)\\{if\\(document\\.hidden\\)TRK\\.end\\('hidden'\\)",
    "maps": "helper: demo_end hidden"
   },
   {
    "type": "pagehide",
    "match": "window\\.addEventListener\\('pagehide',function\\(\\)\\{TRK\\.end\\('leave'\\)",
    "maps": "helper: demo_end leave"
   },
   {
    "type": "click",
    "match": "document\\.addEventListener\\('click',function\\(e\\)\\{var a=e\\.target&&e\\.target\\.closest&&e\\.target\\.closest\\('a\\[data-track\\]'\\)",
    "maps": "helper: demo_end back or home"
   },
   {
    "type": "error",
    "match": "window\\.addEventListener\\('error',function\\(ev\\)\\{if\\(ev&&ev\\.filename",
    "maps": "helper: demo_error js"
   },
   {
    "type": "unhandledrejection",
    "match": "window\\.addEventListener\\('unhandledrejection',function\\(\\)\\{TRK\\.err\\('promise'\\)",
    "maps": "helper: demo_error promise"
   },
   {
    "type": "sk",
    "match": "window\\.addEventListener\\('sk:consent',function\\(\\)\\{setTimeout\\(rv,50\\)",
    "maps": "helper: return_visit check"
   }
  ],
  "shared_events": [
   "demo_open",
   "first_interaction",
   "demo_start",
   "demo_engaged (10 s and 60 s active)",
   "demo_end",
   "demo_error",
   "return_visit (needs consent granted)",
   "fps bucket (Agora only: the only demo with an animation loop)"
  ]
 },
 "pages": {
  "demos/agora.html": {
   "demo_id": "agora",
   "controls": {
    "agora.home": {
     "kind": "link",
     "emits": {
      "click": []
     },
     "lifecycle": {
      "click": [
       "track:demo_end[reason=%R]"
      ]
     },
     "note": "Navigation link: the generic ui_click or nav_click comes from track.js, the page adds demo_end."
    },
    "agora.back": {
     "kind": "link",
