{
 "_schema": "pages -> controls (selector -> events or ignored reason) and listeners (type@target -> events or ignored reason). Keys are stable, not line numbers. Every page also carries the shared helper events: demo_open, first_interaction, demo_start, demo_engaged (10 s, 60 s), demo_end (reason back|home|leave), demo_error (js|promise|load|play|audio), demo_action fps (bucket), return_visit, revisit, gate_exit. Camera and mic pages add media_result and model_state.",
 "demos/hands.html": {
  "controls": {
   "#startBtn[data-track=\"hands.start\"]": {
    "events": [
     "demo_action:start_camera",
     "demo_action:retry",
     "media_result",
     "model_state",
     "demo_start"
    ],
    "n": 1
   },
   "a[data-track=\"hands.home\"]": {
    "events": [
     "demo_end:home"
    ],
    "also": "nav_click by track.js",
    "n": 1
   },
   "a[data-track=\"hands.back\"]": {
    "events": [
     "demo_end:back"
    ],
    "also": "nav_click by track.js",
    "n": 1
   },
   "canvas#overlay[data-track=\"hands.overlay\"]": {
    "ignored": "display only, pointer-events none",
    "n": 1
   },
   "video#cam[data-track=\"hands.cam\"]": {
    "ignored": "camera preview, display only, never read",
    "n": 1
   },
   "#cursor, .target": {
    "ignored": "virtual cursor and targets, driven by hand landmarks, hits tracked as target_hit",
    "optional": true
   }
  },
  "listeners": [
   {
    "type": "pagehide",
    "match": "window\\.addEventListener\\('pagehide',function\\(\\)\\{MT\\.end\\('leave'\\);\\}\\);",
    "n": 1,
    "events": [
     "demo_end",
     "media_result:stopped"
    ],
    "as": "pagehide@window"
   },
   {
    "type": "pageshow",
    "match": "window\\.addEventListener\\('pageshow',function\\(e\\)\\{if\\(e&&e\\.persisted\\)S\\.end",
    "n": 1,
    "ignored": "re-arms demo_end after bfcache restore, no event",
    "as": "pageshow@window"
   },
   {
    "type": "click",
    "match": "document\\.addEventListener\\('click',function\\(e\\)\\{var a=e\\.target&&e\\.target",
    "n": 1,
    "events": [
     "demo_end"
    ],
    "as": "click@document(capture) back/home"
   },
   {
    "type": "error",
    "match": "window\\.addEventListener\\('error',function\\(ev\\)\\{try\\{var t=ev&&ev\\.target;i",
    "n": 1,
    "events": [
     "demo_error"
    ],
    "as": "error@window"
   },
   {
    "type": "unhandledrejection",
    "match": "window\\.addEventListener\\('unhandledrejection',function\\(\\)\\{MT\\.err\\('promis",
    "n": 1,
    "events": [
     "demo_error"
    ],
    "as": "unhandledrejection@window"
   },
   {
    "type": "resize",
    "match": "resize\\(\\); addEventListener\\('resize', resize\\);",
    "n": 1,
    "ignored": "layout only",
    "as": "resize@window"
   },
   {
    "type": "onclick",
    "match": "document\\.getElementById\\('startBtn'\\)\\.onclick = async \\(\\) => \\{",
    "n": 1,
    "events": [
     "demo_action:start_camera",
     "demo_action:retry"
    ],
    "as": "onclick@#startBtn"
   }
  ],
  "behaviour": {
   "pointerdown|keydown|touchstart@document(capture)": {
    "events": [
     "demo_action:first_interaction"
    ]
   },
   "setInterval 1s": {
    "events": [
     "demo_engaged"
    ]
   },
   "consent controls (sk-consent-*)": {
    "ignored": "owned by js/consent.js"
   },
   "camera.start (getUserMedia inside MediaPipe Camera)": {
    "events": [
     "media_result:prompt|granted|denied|dismissed|unavailable|failed"
    ]
   },
   "hands.onResults (landmarks)": {
    "events": [
     "model_state:loaded",
     "demo_action:hand_found",
     "demo_action:hand_lost",
     "demo_action:target_hit",
     "demo_action:first_hit",
     "demo_action:all_targets_done",
     "demo_action:pinch_count",
     "demo_action:misses",
     "demo_action:targets_cleared"
    ],
    "note": "transitions only, loss debounced 700 ms, summaries debounced 1.5 s; landmarks never sent"
   }
  }
 },
