    ]
   },
   "onclick@#rainBtn": {
    "events": [
     "demo_action:rain_balls"
    ]
   },
   "onclick@#startBtn": {
    "events": [
     "demo_action:start_camera"
    ]
   },
   "getUserMedia (video)": {
    "events": [
