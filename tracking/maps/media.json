   "loop: colour mask": {
    "events": [
     "demo_action:match_found",
     "demo_action:match_lost",
     "demo_action:balls_caught_bucket",
     "demo_action:balls_caught",
     "demo_action:fps"
    ],
    "note": "600 ms hold before a match flips, caught = unique balls that touched the paddle, bucket on change only; pixels never sent"
   }
  }
 },
