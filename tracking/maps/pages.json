{
 "version": 1,
 "owner": "pages",
 "note": "Selectors map controls that cannot carry data-track. listeners are keyed by file; n is the most sites of that type allowed, so one new listener fails the gate. The media.json map only checks that a listener type appears (weaker); tools.json matches by source line.",
 "common": {
  "controls": {
   "[data-consent-open]": {
    "events": [
     "consent_reopened"
    ],
    "note": "footer button from js/consent.js (client)"
   },
   ".lb-overlay button": {
    "events": [
     "lightbox_nav",
     "lightbox_close"
    ],
    "note": "lightbox buttons built by js/lightbox.js (client)"
   },
   "#sk-news input, #sk-news button, #sk-news-fab": {
    "events": [
     "newsletter_fab_click",
     "newsletter_start",
     "newsletter_invalid",
     "newsletter_request",
     "newsletter_failed"
    ],
    "note": "newsletter box built by js/newsletter.js (client)"
   }
  }
 },
 "pages": {
  "work.html": {
   "controls": {
    "#panelContent a, #panelContent button": {
     "events": [
      "ui_click",
      "outbound_click"
     ],
     "note": "runtime markup built by script, so it cannot carry a static id: js/track.js names it zone.tag.label (ui_click) and the owning script emits the specific event"
    }
   },
   "states": [
    {
     "name": "panel",
     "steps": [
      {
       "eval": "openPanel('cyrano')",
       "wait": 600
      }
     ]
    }
   ]
  },
  "gallery.html": {
   "controls": {
    "#panelContent a, #panelContent button": {
     "events": [
      "ui_click"
     ],
     "note": "runtime markup built by script, so it cannot carry a static id: js/track.js names it zone.tag.label (ui_click) and the owning script emits the specific event"
    }
   },
   "states": [
    {
     "name": "panel",
     "steps": [
      {
       "eval": "openPanel('casamota')",
       "wait": 600
      }
     ]
    }
   ]
  },
  "build-log/index.html": {
   "controls": {
    "#s-links a, #s-last a, #log a": {
     "events": [
      "ui_click",
      "outbound_click"
     ],
     "note": "runtime markup built by script, so it cannot carry a static id: js/track.js names it zone.tag.label (ui_click) and the owning script emits the specific event"
    }
   }
  },
  "index.html": {
   "controls": {
    "canvas#ambientFloat": {
     "ignored": "decorative icon field, aria-hidden, no pointer events; its cursor push is demo_action pg.home icons_pushed"
    }
   }
  },
  "thallo/index.html": {
   "controls": {
    "video[aria-label=\"Thallo launch film\"]": {
     "events": [
      "video_state",
      "video_progress"
     ],
     "note": "native controls; js/track.js reads play, pause, ended, mute, fullscreen and 25/50/75/100 on any video with controls"
    }
   }
  }
 },
 "plan_rows": {
  "Home": {
   "hero_view and hero_settled": "demo_action pg.home hero_view, hero_settled(ms) from js/hero-loop.js",
   "hero_cta": "ui_click hero-experience.*",
   "work card view and open": "section_view work-section, ui_click work-section.*",
   "marquee hover": "demo_action pg.home marquee_hover(ms) from js/interactions.js",
   "louvre shutter progress": "demo_action pg.home shutter_progress 25|50|75|100",
   "discipline split view": "section_view discipline-split",
   "about teaser click": "ui_click about-teaser.about",
   "skills ball": "demo_action pg.home icons_pushed, icons_pushed_seconds (the home icon field has no throw mechanic)"
  },
  "Work": {
   "filter, open, close, prev, next, dwell": "client wired in work.html (filter_apply, project_*)",
   "project hover preview": "project_preview from js/hover-preview.js and js/work-editorial.js"
  },
  "Gallery": {
   "filter, open, close, prev, next, dwell, lightbox": "client wired",
   "project hover preview": "project_preview from js/hover-preview.js"
  },
  "About": {
   "portrait, bio, timeline item, certificate, skills, achievements views": "section_view (data-section stamped by the codemod, items timeline-N and cert-N)",
   "skills-ball": "no such control on about.html"
  },
  "Process": {
   "intro and step views": "section_view process-intro, step-N",
   "furthest step": "demo_action pg.process furthest_step"
  },
  "Demos index": {
   "category filter": "filter_apply list_id=demos",
   "tile view and hover": "section_view tile-*, ui_hover",
   "open": "ui_click tile links",
   "return after demo": "demo_action pg.demos return_from_demo item=slug"
  },
  "Blog": {
   "card open": "ui_click",
