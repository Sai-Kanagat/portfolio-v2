   "blink-to-scroll": "client wired"
  },
  "Contact": {
   "all": "client wired (form_*)"
  },
  "Brand identity": {
   "sections with dwell": "section_view on 17 sections (plan said 14)",
   "nav jump": "ui_click intro.*",
   "token or colour copy": "generic copy event; no copy buttons exist",
   "asset download": "no download link exists (the template tile is not a link)",
   "component tried": "ui_click components.*"
  },
  "Aperol": {
   "section views": "section_view",
   "deck and memo download": "file_download pptx, docx",
   "microsite open": "ui_click",
   "menu jump": "ui_click",
   "film view": "ui_click on the play placeholder (no video exists)",
   "mock signup attempt": "form_submit_attempt form_id=aperol_mock; never a success"
  },
  "Thallo": {
   "section views, menu jumps": "section_view, ui_click",
   "waitlist forms, film": "client wired (thallo.js forms, track.js video)"
